# ============================================================
# AI / Gemini
# ============================================================
GEMINI_API_KEYS=your_key1_here,your_key2_here,your_key3_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_BASE_BACKOFF_SECONDS=1.0
GEMINI_MAX_BACKOFF_SECONDS=60.0
GEMINI_MAX_HISTORY_TURNS=15

# ============================================================
# Database — Supabase PostgreSQL
# ============================================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# Redis
# Dùng REDIS_URL cho cloud (redis.io), hoặc REDIS_HOST/PORT cho local
# ============================================================
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30

# ============================================================
# Dataset & Pipeline
# ============================================================
DATASET_PATH=data/dataset.csv
CITIES_SCOPE=vietnam # vietnam | all
PIPELINE_CRON=02:00

# ============================================================
# Feature Toggles
# ============================================================
# ENABLE_AUTO_EXECUTE:
#   true  = approve code -> hệ thống tự chạy server-side -> trả kết quả
#   false = approve code -> user copy code -> chạy local bằng runner/runner.py
ENABLE_AUTO_EXECUTE=false
APP_ENV=development
